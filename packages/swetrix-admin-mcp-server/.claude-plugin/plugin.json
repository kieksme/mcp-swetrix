{
  "name": "swetrix-admin",
  "description": "Manage Swetrix projects, funnels, annotations, views and organisations via MCP.",
  "version": "1.1.3",
  "author": {
    "name": "kieksme",
    "url": "https://github.com/kieksme"
  },
  "homepage": "https://swetrix.com/docs/admin-api",
  "repository": "https://github.com/kieksme/mcp-swetrix",
  "license": "GPL-3.0-only",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "swetrix",
    "analytics",
    "admin",
    "projects"
  ],
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "Swetrix API key",
      "description": "API key for the Swetrix account",
      "sensitive": true,
      "required": true
    },
    "api_base_url": {
      "type": "string",
      "title": "Swetrix API base URL",
      "description": "Defaults to https://api.swetrix.com",
      "required": false
    }
  }
