{
  "name": "@kieksme/swetrix-admin-mcp",
  "version": "1.4.0",
  "description": "MCP server for the Swetrix Admin API – manages projects, funnels, annotations, views and organisations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-swetrix-admin": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "swetrix",
    "analytics",
    "admin",
    "projects",
    "claude"
  ],
  "author": "kieksme",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieksme/mcp-swetrix.git",
    "directory": "packages/swetrix-admin-mcp-server"
  },
  "homepage": "https://swetrix.com/docs/admin-api",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^2.1.9",
    "msw": "^2.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
